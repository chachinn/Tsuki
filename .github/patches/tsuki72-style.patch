--- a/style.css
+++ b/style.css
@@ -5884,3 +5884,234 @@
   font-weight: 800;
   letter-spacing: 0.04em;
 }
+
+
+/* ============================================================
+   TSUKI 7.2 — TUTORIAL, WHAT'S NEW & DIAGNOSTICS
+   ============================================================ */
+.tutorial-modal,
+.whats-new-modal {
+  max-width: 520px;
+}
+
+.tutorial-modal {
+  text-align: center;
+  padding-bottom: calc(22px + env(safe-area-inset-bottom));
+}
+
+.tutorial-progress-row {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  color: var(--text-soft, #8e7883);
+  font-size: .82rem;
+  font-weight: 700;
+}
+
+.tutorial-skip {
+  border: 0;
+  background: transparent;
+  color: var(--pink-600, #cf7394);
+  font: inherit;
+  font-weight: 800;
+  padding: 8px 4px;
+}
+
+.tutorial-visual {
+  width: 92px;
+  height: 92px;
+  margin: 18px auto 14px;
+  border-radius: 30px;
+  display: grid;
+  place-items: center;
+  font-size: 3rem;
+  background: linear-gradient(145deg, rgba(255,255,255,.96), rgba(249,220,233,.82));
+  box-shadow: 0 15px 36px rgba(142, 83, 113, .13);
+}
+
+.tutorial-modal h2 {
+  margin: 6px 0 10px;
+}
+
+.tutorial-copy {
+  margin: 0 auto;
+  max-width: 430px;
+  line-height: 1.65;
+  color: var(--text-soft, #77636d);
+}
+
+.tutorial-tip {
+  min-height: 48px;
+  margin: 18px 0 14px;
+  padding: 12px 14px;
+  border-radius: 16px;
+  background: rgba(247, 210, 226, .43);
+  color: var(--text, #57444e);
+  font-size: .9rem;
+  line-height: 1.45;
+}
+
+.tutorial-dots {
+  display: flex;
+  justify-content: center;
+  gap: 7px;
+  margin: 5px 0 18px;
+}
+
+.tutorial-dot {
+  width: 7px;
+  height: 7px;
+  border-radius: 999px;
+  background: rgba(151, 118, 132, .22);
+  transition: width .18s ease, background .18s ease;
+}
+
+.tutorial-dot.active {
+  width: 22px;
+  background: var(--pink-500, #df8fac);
+}
+
+.tutorial-actions,
+.whats-new-actions,
+.diagnostics-actions {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 10px;
+}
+
+.tutorial-actions .primary-button,
+.tutorial-actions .secondary-button,
+.whats-new-actions .primary-button,
+.whats-new-actions .secondary-button,
+.diagnostics-actions .secondary-button {
+  width: 100%;
+  min-height: 46px;
+}
+
+.whats-new-hero {
+  display: flex;
+  align-items: center;
+  gap: 14px;
+  padding: 15px;
+  margin-bottom: 12px;
+  border-radius: 20px;
+  background: linear-gradient(135deg, rgba(251,226,237,.86), rgba(237,229,252,.82));
+}
+
+.whats-new-hero > span {
+  font-size: 2rem;
+}
+
+.whats-new-hero div {
+  display: flex;
+  flex-direction: column;
+  gap: 3px;
+}
+
+.whats-new-hero small {
+  color: var(--text-soft, #8e7883);
+}
+
+.whats-new-list {
+  display: grid;
+  gap: 9px;
+  margin: 12px 0 18px;
+  max-height: min(48vh, 430px);
+  overflow: auto;
+  overscroll-behavior: contain;
+}
+
+.whats-new-item {
+  display: grid;
+  grid-template-columns: 38px 1fr;
+  gap: 11px;
+  align-items: start;
+  padding: 12px;
+  border: 1px solid rgba(190, 151, 169, .18);
+  border-radius: 16px;
+  background: rgba(255,255,255,.65);
+}
+
+.whats-new-item > span {
+  width: 38px;
+  height: 38px;
+  display: grid;
+  place-items: center;
+  border-radius: 13px;
+  background: rgba(249, 218, 232, .62);
+  font-size: 1.15rem;
+}
+
+.whats-new-item strong,
+.whats-new-item small {
+  display: block;
+}
+
+.whats-new-item small {
+  margin-top: 3px;
+  color: var(--text-soft, #8e7883);
+  line-height: 1.4;
+}
+
+.diagnostics-card {
+  padding: 0;
+  overflow: hidden;
+}
+
+.diagnostics-card > summary {
+  list-style: none;
+  cursor: pointer;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 12px;
+  padding: 18px;
+  -webkit-tap-highlight-color: transparent;
+}
+
+.diagnostics-card > summary::-webkit-details-marker { display: none; }
+.diagnostics-card > summary span:first-child { display: flex; flex-direction: column; gap: 3px; }
+.diagnostics-card > summary small { color: var(--text-soft, #8e7883); font-weight: 500; }
+.diagnostics-chevron { transition: transform .18s ease; }
+.diagnostics-card[open] .diagnostics-chevron { transform: rotate(180deg); }
+.diagnostics-body { padding: 0 18px 18px; }
+
+.diagnostics-grid {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 9px;
+  margin: 14px 0;
+}
+
+.diagnostics-grid > div {
+  min-width: 0;
+  padding: 12px;
+  border-radius: 15px;
+  background: rgba(248, 230, 239, .52);
+}
+
+.diagnostics-grid small,
+.diagnostics-grid strong {
+  display: block;
+}
+
+.diagnostics-grid small {
+  color: var(--text-soft, #8e7883);
+  margin-bottom: 3px;
+}
+
+.diagnostics-grid strong {
+  overflow-wrap: anywhere;
+}
+
+@media (max-width: 390px) {
+  .tutorial-actions,
+  .whats-new-actions,
+  .diagnostics-actions { grid-template-columns: 1fr; }
+  .diagnostics-grid { grid-template-columns: 1fr; }
+  .tutorial-visual { width: 80px; height: 80px; font-size: 2.6rem; }
+}
+
+.reduce-motion .tutorial-dot,
+.reduce-motion .diagnostics-chevron { transition: none !important; }
